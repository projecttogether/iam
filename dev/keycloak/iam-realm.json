{
  "realm": "iam",
  "enabled": true,
  "displayName": "IAM development",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "keycloak@example.invalid",
    "fromDisplayName": "Keycloak (development)"
  },
  "groups": [
    {
      "name": "iam",
      "path": "/iam",
      "subGroups": [
        { "name": "admins", "path": "/iam/admins" },
        { "name": "approvers", "path": "/iam/approvers" }
      ]
    },
    {
      "name": "apps",
      "path": "/apps",
      "subGroups": [
        { "name": "wiki", "path": "/apps/wiki" },
        { "name": "chat", "path": "/apps/chat" },
        { "name": "finance", "path": "/apps/finance" }
      ]
    },
    {
      "name": "teams",
      "path": "/teams",
      "subGroups": [
        { "name": "product", "path": "/teams/product" },
        { "name": "operations", "path": "/teams/operations" }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "iam",
      "name": "IAM sign-in",
      "enabled": true,
      "publicClient": false,
      "secret": "iam-dev-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8000/oidc/callback/", "http://localhost:5173/oidc/callback/"],
      "webOrigins": ["http://localhost:8000", "http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8000/login/##http://localhost:5173/login/",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "iam-provisioner",
      "name": "IAM provisioning",
      "enabled": true,
      "publicClient": false,
      "secret": "iam-dev-provisioner-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "kc-admin-api"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.invalid",
      "firstName": "Dev",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "groups": ["/iam/admins"]
    },
    {
      "username": "service-account-iam-provisioner",
      "enabled": true,
      "serviceAccountClientId": "iam-provisioner",
      "clientRoles": {
        "realm-management": ["view-users", "query-users", "manage-users", "query-groups", "view-realm"]
      }
    }
  ]
}
