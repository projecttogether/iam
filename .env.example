# Local development (CONTRIBUTING.md). Copy to .env, then start the services:
#   docker compose -f compose.dev.yaml up -d
# Every variable is described in docs/configuration.md.
NODE_ENV=development
DATABASE_URL=postgresql://iam:iam@localhost:55438/iam
# The web app runs on Vite (npm run dev); the API on port 8000 behind it.
APP_URL=http://localhost:5173
PORT=8000
# Sign-in with the development Keycloak (realm "iam", user admin@example.invalid / admin).
KEYCLOAK_URL=http://localhost:8098
KEYCLOAK_REALM=iam
OIDC_CLIENT_ID=iam
OIDC_CLIENT_SECRET=iam-dev-client-secret
# Members of this Keycloak group become admins at sign-in.
OIDC_ADMIN_GROUPS=/iam/admins
OIDC_APPROVER_GROUPS=/iam/approvers
# Development sign-in without Keycloak (NODE_ENV=development only).
# DEV_LOGIN=1
# Read-only mode: read connected apps, change nothing in them, send no email.
# READ_ONLY=1

# Production with compose.yaml: new secrets, URLs and sign-in values instead
# (docs/deployment.md), and optionally the image to run: latest (default) or
# sha-<commit>.
# IAM_IMAGE_TAG=latest
